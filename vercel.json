{
  "headers": [
    {
      "source": "/calendar/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/buketim",
      "destination": "https://buket-dogum-gunu.vercel.app/"
    },
    {
      "source": "/buketim/",
      "destination": "https://buket-dogum-gunu.vercel.app/"
    },
    {
      "source": "/buketim/:path*",
      "destination": "https://buket-dogum-gunu.vercel.app/:path*"
    },
    {
      "source": "/cekilis/",
      "destination": "https://immense-api.alicaglarkocer.com/cekilis/"
    },
    {
      "source": "/cekilis/:path*",
      "destination": "https://immense-api.alicaglarkocer.com/cekilis/:path*"
    },
    {
      "source": "/calendar/api/:path*",
      "destination": "http://167.235.158.118/ajanda/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "alicaglarkocer.com"
        }
      ],
      "destination": "https://www.alicaglarkocer.com/",
      "permanent": true
    },
    {
      "source": "/:path((?!buketim(?:/|$)).+)",
      "has": [
        {
          "type": "host",
          "value": "alicaglarkocer.com"
        }
      ],
      "destination": "https://www.alicaglarkocer.com/:path",
      "permanent": true
    },
    {
      "source": "/projects/sentinel/",
      "destination": "/projects/cluesight/",
      "permanent": true
    },
    {
      "source": "/projects/sentinel",
      "destination": "/projects/cluesight/",
      "permanent": true
    },
    {
      "source": "/assets/projects/sentinel/sentinel-:filename",
      "destination": "/assets/projects/cluesight/cluesight-:filename",
      "permanent": true
    },
    {
      "source": "/cekilis",
      "destination": "/cekilis/",
      "permanent": false
    },
    {
      "source": "/ack-techs/",
      "destination": "https://ack-techs.com/",
      "permanent": true
    },
    {
      "source": "/ack-techs/:path*/",
      "destination": "https://ack-techs.com/:path*/",
      "permanent": true
    },
    {
      "source": "/ack-techs",
      "destination": "https://ack-techs.com/",
      "permanent": true
    },
    {
      "source": "/ack-techs/:path*",
      "destination": "https://ack-techs.com/:path*",
      "permanent": true
    }
  ]
}
