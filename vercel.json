{
  "headers": [
    {
      "source": "/calendar/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/calendar/api/:path*",
      "destination": "http://167.235.158.118/ajanda/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/ack-techs",
      "destination": "https://ack-techs.com/",
      "permanent": true
    },
    {
      "source": "/ack-techs/:path*",
      "destination": "https://ack-techs.com/:path*",
      "permanent": true
    }
  ]
}
