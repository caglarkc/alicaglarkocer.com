{
  "headers": [
    {
      "source": "/calendar/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/cekilis/",
      "destination": "https://immense-api.alicaglarkocer.com/cekilis/"
    },
    {
      "source": "/cekilis/:path*",
      "destination": "https://immense-api.alicaglarkocer.com/cekilis/:path*"
    },
    {
      "source": "/calendar/api/:path*",
      "destination": "http://167.235.158.118/ajanda/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/cekilis",
      "destination": "/cekilis/",
      "permanent": false
    },
    {
      "source": "/ack-techs/",
      "destination": "https://ack-techs.com/",
      "permanent": true
    },
    {
      "source": "/ack-techs/:path*/",
      "destination": "https://ack-techs.com/:path*/",
      "permanent": true
    },
    {
      "source": "/ack-techs",
      "destination": "https://ack-techs.com/",
      "permanent": true
    },
    {
      "source": "/ack-techs/:path*",
      "destination": "https://ack-techs.com/:path*",
      "permanent": true
    }
  ]
}
